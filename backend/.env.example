# Copy this file to .env once, then edit .env for your computer.
# Update .env manually when the configuration changes.
# Keep real passwords and service account keys out of this shared example.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Always relative to backend/, on any drive and from any working directory.
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json
DEVICE_ID=esp32-01

# Local HiveMQ on the same computer. Fill credentials only if authentication is enabled.
# HiveMQ Cloud instead uses mqtts://cluster-hostname:8883 and MQTT credentials.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional MQTT settings.
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_RECONNECT_PERIOD_MS=2000

# Local Firestore Emulator only. Leave this commented for the real cloud.
# Also set FIREBASE_PROJECT_ID=demo-smartclassroom when testing locally.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
