# Chép file này thành .env rồi sửa. KHÔNG commit .env.
# Mọi biến đều có giá trị mặc định; để trống là dùng mặc định.

# Cổng HTTP + WebSocket
PORT=3000

# Broker MQTT. Giả lập: broker cục bộ (npm run broker).
# Thật: mqtts://<cluster>.s1.eu.hivemq.cloud:8883
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASS=

# Mã thiết bị, phải khớp contract/system.json
DEVICE_ID=sc-01

# sim: dữ liệu giả lập (giao diện hiện nhãn "GIẢ LẬP") · live: thiết bị thật
MODE=sim

# Nguồn dữ liệu lịch sử: memory (giả lập) · firestore (Tuấn, ID 4–5)
HISTORY_PROVIDER=memory

# Chỉ khi MODE=sim + memory: gieo sẵn N giờ dữ liệu giả để dải "24 GIỜ QUA" có số ngay (0 = không gieo).
# npm run dev tự đặt 24.
HISTORY_SEED_HOURS=0

# Đăng nhập (ID 8). false = không chặn truy cập
AUTH_ENABLED=false

# Tắt plugin theo tên file, cách nhau bằng dấu phẩy. Ví dụ: firestore,telegram
PLUGINS_DISABLED=

# Thư mục dữ liệu lúc chạy (bảng màu LED gửi gần nhất), tính từ server/. Đã ignore.
DATA_DIR=data

# error | warn | info | debug
LOG_LEVEL=info
