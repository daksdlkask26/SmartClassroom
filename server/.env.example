# Chạy npm run env:init để tạo .env, hoặc npm run env:update để thêm các biến còn thiếu.
# KHÔNG commit .env.
# Mọi biến đều có giá trị mặc định; để trống là dùng mặc định.

# Cổng HTTP + WebSocket
PORT=3000

# Broker MQTT mặc định để chạy cục bộ bằng npm run broker hoặc npm run dev.
# MQTT_URL gồm giao thức, host và cổng. Điền thông tin đăng nhập trong MQTT_USER và MQTT_PASS.
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASS=

# Mã thiết bị trong topic MQTT, khớp với ESP32 hoặc bộ giả lập.
DEVICE_ID=sc-01

# sim: dữ liệu giả lập (giao diện hiện nhãn "GIẢ LẬP") · live: thiết bị thật
MODE=sim

# Sau khi broker HiveMQ Cloud Starter ở trạng thái Running, điền giá trị thật vào MODE và MQTT_* trong .env.
# MODE=live
# MQTT_URL=mqtts://your-cluster.a01.euc1.aws.hivemq.cloud:8883
# MQTT_USER=your-mqtt-username
# MQTT_PASS="your-mqtt-password"
# Hostname ở trên là ví dụ. Tại https://app.hivemq.com, mở broker rồi sao chép toàn bộ hostname trong Overview.
# Dùng MQTT qua TLS cổng 8883. Username và password MQTT tạo ở Access Management → Credentials.
# npm start đọc cấu hình này. npm run dev dùng broker cục bộ.

# Nguồn dữ liệu lịch sử: memory (giả lập, mất khi tắt) · firestore (đọc từ Firestore, cần khối FIREBASE bên dưới)
HISTORY_PROVIDER=memory

# Chỉ khi MODE=sim + memory: gieo sẵn N giờ dữ liệu giả để dải "24 GIỜ QUA" có số ngay (0 = không gieo).
# npm run dev tự đặt 24.
HISTORY_SEED_HOURS=0

# Đăng nhập (ID 8). false = không chặn truy cập
AUTH_ENABLED=false

# Tắt plugin theo tên file, cách nhau bằng dấu phẩy. Ví dụ: firestore,telegram
PLUGINS_DISABLED=

# Thư mục dữ liệu lúc chạy (bảng màu LED gửi gần nhất, người nhận Telegram), tính từ server/. Đã ignore.
DATA_DIR=data

# error | warn | info | debug
LOG_LEVEL=info

# ---------- Firestore (ID 4, 5). Bỏ trống FIREBASE_PROJECT_ID thì plugin firestore tự tắt ----------
# Chỉ MỘT máy được bật plugin này khi nhiều máy cùng nối HiveMQ thật; máy khác đặt PLUGINS_DISABLED=firestore.
# Dữ liệu giả lập (MODE=sim) ghi vào collection riêng readings_sim / hourly_sim.
FIREBASE_PROJECT_ID=
# Khóa service account tải từ Firebase Console. Đường dẫn tương đối tính từ thư mục server/. KHÔNG commit file khóa.
GOOGLE_APPLICATION_CREDENTIALS=./firebase/serviceAccountKey.json
# Chỉ khi thử với Emulator (npm run emulators): đặt FIREBASE_PROJECT_ID=demo-smartclassroom và bỏ comment dòng dưới.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# ---------- Telegram (ID 6, 7). Bỏ trống TELEGRAM_BOT_TOKEN thì plugin telegram tự tắt ----------
# Tạo bot bằng @BotFather. Dùng bot RIÊNG cho MODE=sim (mọi tin giả lập có nhãn [GIẢ LẬP]).
# Chỉ MỘT máy được chạy bot với mỗi token; máy khác đặt PLUGINS_DISABLED=telegram. KHÔNG commit token.
TELEGRAM_BOT_TOKEN=
# Tên bot, không có @, ví dụ SmartClassroom16Bot. Công khai: hiện trên trang Telegram của website.
TELEGRAM_BOT_USERNAME=
# Chat ID được dùng bot, cách nhau bằng dấu phẩy. Để trống = ai tìm thấy bot cũng dùng được.
# Người chưa được phép gửi /start sẽ nhận lại chat ID của họ để thêm vào đây.
TELEGRAM_ALLOWED_CHAT_IDS=
