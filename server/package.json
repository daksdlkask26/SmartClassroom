{
  "name": "smartclassroom-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Smart Classroom (nhóm 16): MQTT → WebSocket, REST API, Firestore, phục vụ giao diện web",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "env:init": "node scripts/sync-env.js init",
    "env:update": "node scripts/sync-env.js update",
    "start": "node src/index.js",
    "start:watch": "node --watch src/index.js",
    "dev": "node scripts/dev.js",
    "broker": "node scripts/dev-broker.js",
    "sim": "node scripts/sim-esp32.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node scripts/emulator/run.js test",
    "emulators": "node scripts/emulator/run.js start",
    "check:firestore": "node --env-file-if-exists=.env scripts/emulator/smoke-firestore.js",
    "readings": "node --env-file-if-exists=.env scripts/emulator/list-readings.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "firebase-admin": "14.5.1",
    "mqtt": "5.16.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "aedes": "1.2.0"
  }
}
